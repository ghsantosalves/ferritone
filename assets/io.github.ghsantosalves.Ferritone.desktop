[Desktop Entry]
Type=Application
Name=Ferritone
Comment=Play music and manage playlists
Comment[pt_BR]=Reproduza músicas e gerencie listas de reprodução
Exec=ferritone
Icon=io.github.ghsantosalves.Ferritone
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupNotify=true
StartupWMClass=io.github.ghsantosalves.Ferritone
Actions=PlayPause;Previous;Next;

[Desktop Action PlayPause]
Name=Play/Pause
Name[pt_BR]=Tocar/Pausar
Exec=sh -c "gdbus call --session --dest org.mpris.MediaPlayer2.Ferritone --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.PlayPause >/dev/null 2>&1 || exec ferritone"

[Desktop Action Previous]
Name=Previous Track
Name[pt_BR]=Faixa anterior
Exec=sh -c "gdbus call --session --dest org.mpris.MediaPlayer2.Ferritone --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.Previous >/dev/null 2>&1 || exec ferritone"

[Desktop Action Next]
Name=Next Track
Name[pt_BR]=Próxima faixa
Exec=sh -c "gdbus call --session --dest org.mpris.MediaPlayer2.Ferritone --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.Next >/dev/null 2>&1 || exec ferritone"
