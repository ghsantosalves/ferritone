[Desktop Entry]
Type=Application
Name=Ferritone
Comment=Play music and manage playlists
Comment[pt_BR]=Reproduza músicas e gerencie listas de reprodução
Exec=rust-music-player
Icon=io.github.rustmusicplayer.Player
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupNotify=true
StartupWMClass=io.github.rustmusicplayer.Player
Actions=PlayPause;Previous;Next;

[Desktop Action PlayPause]
Name=Play/Pause
Name[pt_BR]=Tocar/Pausar
Exec=gdbus call --session --dest org.mpris.MediaPlayer2.Ferritone --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.PlayPause

[Desktop Action Previous]
Name=Previous Track
Name[pt_BR]=Faixa anterior
Exec=gdbus call --session --dest org.mpris.MediaPlayer2.Ferritone --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.Previous

[Desktop Action Next]
Name=Next Track
Name[pt_BR]=Próxima faixa
Exec=gdbus call --session --dest org.mpris.MediaPlayer2.Ferritone --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.Next
